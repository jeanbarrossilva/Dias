<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_height="match_parent"
  android:layout_width="match_parent">
  <com.jeanbarrossilva.dias.app.home.HandleListView
    android:divider="@drawable/home_pinned_apps_divider"
    android:id="@+id/handleListView"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:paddingHorizontal="@dimen/spacing_m"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <com.google.android.material.button.MaterialButton
    android:backgroundTint="?colorPrimaryContainer"
    android:fontFamily="@font/space_grotesk"
    android:id="@+id/all_apps_button"
    android:layout_height="56dp"
    android:layout_width="56dp"
    android:layout_marginEnd="@dimen/spacing_m"
    android:layout_marginBottom="@dimen/spacing_m"
    android:paddingVertical="14dp"
    android:visibility="gone"
    app:iconPadding="0dp"
    app:iconTint="?colorOnPrimaryContainer"
    android:insetBottom="0dp"
    android:insetLeft="0dp"
    android:insetRight="0dp"
    android:insetTop="0dp"
    app:cornerRadius="8dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    tools:contentDescription="@string/home_handle_list_expand"
    tools:icon="@drawable/ic_expand_content"
    tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>